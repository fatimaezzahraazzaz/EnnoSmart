# Preflight before consultant selection
ENNOSCHOLAR_PREFLIGHT_ENABLED=1
ENNOSCHOLAR_PREFLIGHT_TOP_K=15
ENNOSCHOLAR_PREFLIGHT_WORKERS=4
ENNOSCHOLAR_PREFLIGHT_USE_LEGAL_MCP=0

# Citation-based discovery
ENNOSCHOLAR_DEEP_DISCOVERY_ENABLED=1
ENNOSCHOLAR_DISCOVERY_SEEDS=3
ENNOSCHOLAR_DISCOVERY_REFS_PER_SEED=4
ENNOSCHOLAR_DISCOVERY_CITES_PER_SEED=4
ENNOSCHOLAR_DISCOVERY_MAX_NEW=18
ENNOSCHOLAR_DISCOVERY_WORKERS=6
OPENCITATIONS_TIMEOUT=6
OPENCITATIONS_MAX_RETRIES=1
OPENCITATIONS_ACCESS_TOKEN=

# Local GROBID fallback
ENNOSCHOLAR_GROBID_ENABLED=1
GROBID_URL=http://127.0.0.1:8070
GROBID_TIMEOUT=45

# Optional Celery/Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
