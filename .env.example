# -----------------------------------------------------------------------------
# EnnoSmart - exemple de configuration de production Linux
# Copier vers .env, remplacer toutes les valeurs CHANGE_ME et chmod 600 .env.
# Ne jamais committer le vrai fichier .env.
# -----------------------------------------------------------------------------

APP_NAME="EnnoSmart Backend API"
ENV=production
ENNOSMART_ROOT=/opt/ennosmart
ENNOSMART_BASE_DIR=/opt/ennosmart
ENNOSMART_STORAGE_ROOT=/opt/ennosmart/storage
UPLOAD_ROOT=/opt/ennosmart/storage/uploads
AI_OUTPUT_ROOT=/opt/ennosmart/outputs/safe_rag_upload

# Sécurité / URLs publiques
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# PostgreSQL (les données restent sur le serveur, jamais dans Git)
POSTGRES_DB=ennosmart
POSTGRES_USER=ennosmart
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg2://ennosmart:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/ennosmart
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
WEB_THREAD_LIMIT=80

# Redis : verrous, capacité LLM, Celery et checkpoints
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_LOCK_DISTRIBUTED=true
SESSION_LOCK_REDIS_URL=redis://127.0.0.1:6379/0
SESSION_LOCK_TTL_SECONDS=3900
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
ENNOSMART_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
ENNOSMART_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
ENNOSMART_CIR_BROKER_URL=redis://127.0.0.1:6379/1
ENNOSMART_CIR_RESULT_BACKEND=redis://127.0.0.1:6379/2
ENNOSMART_CIR_LANGGRAPH_REDIS_URL=redis://127.0.0.1:6379/0
ENNOSMART_CIR_STATUS_REDIS_URL=redis://127.0.0.1:6379/3
ENNOSMART_CIR_REDIS_URL=redis://127.0.0.1:6379/3
ENNOSMART_LANGGRAPH_REDIS_URL=redis://127.0.0.1:6379/0
ENNOSMART_CIR_QUEUE=ennosmart.cir
ENNOSMART_CIR_WORKER_CONCURRENCY=4

# Limite partagée entre API et workers
ENNOSMART_LLM_MAX_CONCURRENCY=8
ENNOSMART_LLM_QUEUE_TIMEOUT_SECONDS=900
ENNOSMART_LLM_SLOT_LEASE_SECONDS=900
ENNOSMART_LLM_DISTRIBUTED_LIMITER=true
ENNOSMART_LLM_REDIS_URL=redis://127.0.0.1:6379/0

# Fournisseur LLM : openai, openrouter, gemini ou ollama
ENNOSMART_LLM_PROVIDER=openai
ENNOSMART_OPENAI_MODEL=gpt-4.1-mini
ENNOSMART_LLM_WRITER_MODEL=gpt-4.1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Modèles : FastJudge est versionné ; les modèles Hugging Face sont téléchargés
# dans le cache serveur au premier usage. Passer OFFLINE à 1 après préchargement.
ENNOSMART_FASTJUDGE_MODEL_PATH=/opt/ennosmart/models/fastjudge/fastjudge_linearsvc_C025.joblib
HF_HOME=/opt/ennosmart/storage/huggingface
HF_TOKEN=
ENNOSMART_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENNOSMART_EMBEDDING_OFFLINE=0
ENNOSCHOLAR_ENABLE_BGE_RERANKER=1
ENNOSCHOLAR_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENNOSCHOLAR_RERANKER_DEVICE=cpu

# Extraction / OCR / audio
OCR_ENGINE=tesseract
OCR_TESSERACT_LANG=eng+fra
TESSERACT_CMD=/usr/bin/tesseract
ENNOSMART_EXTRACTION_FORMULA_MODE=off
ENNOSMART_ENABLE_TRANSCRIPTION=1
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DIARIZATION=false
GROBID_URL=http://127.0.0.1:8070
ENNOSCHOLAR_GROBID_ENABLED=1

# EnnoScholar / MCP légal
ENNOSCHOLAR_REDIS_ENABLED=1
ENNOSCHOLAR_PREFLIGHT_ASYNC=1
ENNOSCHOLAR_PREFLIGHT_ENABLED=1
ENNOSCHOLAR_PREFLIGHT_USE_LEGAL_MCP=1
ENNOSCHOLAR_LEGAL_MCP_ENABLED=1
ENNOSCHOLAR_LEGAL_MCP_HOST=127.0.0.1
ENNOSCHOLAR_LEGAL_MCP_PORT=8010
ENNOSCHOLAR_LEGAL_MCP_URL=http://127.0.0.1:8010/mcp
ENNOSCHOLAR_LEGAL_MCP_REST_URL=http://127.0.0.1:8010/api/resolve
ENNOSCHOLAR_LEGAL_MCP_CACHE_DB=/opt/ennosmart/storage/mcp/legal_fulltext_cache.sqlite3
ENNOSCHOLAR_LEGAL_MCP_AUDIT_LOG=/opt/ennosmart/logs/legal_fulltext_mcp_audit.jsonl
ENNOSCHOLAR_LEGAL_MCP_PROVIDER_ORDER=unpaywall,openalex,crossref,core,hal,arxiv,europe_pmc,zenodo

# Fournisseurs scientifiques (laisser vide pour désactiver la clé concernée)
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
IEEE_XPLORE_API_KEY=
GITHUB_TOKEN=

# SMTP optionnel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# Import documentaire externe optionnel, strictement en lecture seule
POWER_AUTOMATE_IMPORT_ROOT=
POWER_AUTOMATE_AUDIT_ROOT=/opt/ennosmart/storage/power_automate_import
POWER_AUTOMATE_MAX_FILE_MB=100
# Optionnel, uniquement pour les anciens Word .doc (conversion de la copie locale).
LIBREOFFICE_BIN=/usr/bin/libreoffice
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.pptx,.ppt,.xlsx,.xls,.txt,.png,.jpg,.jpeg,.msg
