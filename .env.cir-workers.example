# Celery : Redis est séparé logiquement par DB.
ENNOSMART_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
ENNOSMART_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Etat des jobs + checkpoints LangGraph.
ENNOSMART_CIR_REDIS_URL=redis://127.0.0.1:6379/3
ENNOSMART_LANGGRAPH_REDIS_URL=redis://127.0.0.1:6379/0

ENNOSMART_CIR_QUEUE=ennosmart.cir

# Les tâches CIR peuvent être longues.
ENNOSMART_CELERY_VISIBILITY_TIMEOUT=28800
ENNOSMART_CELERY_RESULT_EXPIRES=86400
ENNOSMART_CIR_STATUS_TTL=86400
ENNOSMART_CIR_LOCK_TTL=43200

# LangGraph
ENNOSMART_LANGGRAPH_RECURSION_LIMIT=1000

# En background, le checkpoint "3 sections puis continue" n'est plus humain :
# le graph appelle automatiquement le chunk suivant.
ENNOAMEL_PROGRESSIVE_MAX_WRITES_PER_TURN=3
