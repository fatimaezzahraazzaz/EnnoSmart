FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/ennosmart:/opt/ennosmart/backend_api

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        default-jre-headless \
        ffmpeg \
        fonts-dejavu-core \
        fonts-liberation \
        libcairo2 \
        libglib2.0-0 \
        libgl1 \
        libmagic1 \
        libpq-dev \
        libreoffice \
        libreoffice-calc \
        libreoffice-impress \
        libreoffice-writer \
        poppler-utils \
        postgresql-client \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
        tesseract-ocr-osd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ennosmart

COPY requirements.txt ./requirements.txt
COPY deploy/ovh/requirements.lock ./requirements-ovh.lock
RUN python -m pip install --no-cache-dir uv==0.12.15 \
    && uv pip install \
        --system \
        --require-hashes \
        --torch-backend cpu \
        -r requirements-ovh.lock \
    && uv pip check --system

COPY . .

# Échoue au build si un nouveau module, le SDK OpenAI ou FastJudge manque.
# Aucun modèle n'est téléchargé ici ; models-init utilise le volume persistant.
RUN python scripts/deployment/check_image.py

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin ennosmart \
    && chown -R ennosmart:ennosmart /opt/ennosmart

USER ennosmart
WORKDIR /opt/ennosmart/backend_api

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
