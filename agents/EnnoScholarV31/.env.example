# Configuration indépendante. Aucun appel payant n'est autorisé par défaut.
ENNOSCHOLAR_V31_ENABLED=true
ENNOSCHOLAR_V31_MODEL=gpt-5.6-sol
ENNOSCHOLAR_V31_PAID_CALLS_AUTHORIZED=false
ENNOSCHOLAR_V31_MAX_COST_USD=4
ENNOSCHOLAR_V31_TIMEOUT_SECONDS=600
ENNOSCHOLAR_V31_REQUEST_TIMEOUT_SECONDS=90
ENNOSCHOLAR_V31_REASONING_EFFORT=medium
ENNOSCHOLAR_V31_MAX_TOOL_CALLS=48
ENNOSCHOLAR_V31_MAX_RESEARCH_ROUNDS=14
ENNOSCHOLAR_V31_MAX_RESPONSE_ROUNDS=40
ENNOSCHOLAR_V31_MAX_ARTICLES=20000
ENNOSCHOLAR_V31_MAX_CONTEXT_CHARS=65000
ENNOSCHOLAR_V31_MAX_OUTPUT_TOKENS=5000
# USD / million de tokens, tarifs documentés le 12 octobre 2026.
ENNOSCHOLAR_V31_INPUT_PRICE=4
ENNOSCHOLAR_V31_OUTPUT_PRICE=20
ENNOSCHOLAR_V31_WEB_CALL_PRICE=0.01
# Facultatif : répertoire d'un encodeur MULTILINGUE déjà installé localement.
# Aucun téléchargement de modèle ni appel d'embedding payant.
ENNOSCHOLAR_V31_EMBEDDING_MODEL_PATH=
ENNOSCHOLAR_V31_CONTACT_EMAIL=
# OPENAI_API_KEY, SEMANTIC_SCHOLAR_API_KEY, OPENALEX_API_KEY : variables existantes.
