# Put these settings in the existing local environment; do not change V1 model settings.
# Official API identifier confirmed; account access must be checked separately.
ENNOSCHOLAR_V2_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
ENNOSCHOLAR_V2_HTTP_TIMEOUT=45
# Targeted analysis recovery and synthesis-only phase; no scientific prompt changes.
SCHOLAR_ANALYSIS_MAX_OUTPUT_TOKENS=3500
SCHOLAR_ANALYSIS_RETRY_MAX_OUTPUT_TOKENS=6000
SCHOLAR_SYNTHESIS_TIMEOUT_SECONDS=90
SCHOLAR_SYNTHESIS_RETRY_TIMEOUT_SECONDS=60
ENNOSCHOLAR_V2_SOFT_TIME_LIMIT=180
ENNOSCHOLAR_V2_HARD_TIME_LIMIT=600
# Legacy ENNOSCHOLAR_V2_TURN_TIMEOUT remains an alias of the hard limit.
ENNOSCHOLAR_V2_ANALYSIS_RESERVE=90
ENNOSCHOLAR_V2_SYNTHESIS_RESERVE=90
ENNOSCHOLAR_V2_FULLTEXT_ARTICLE_TIMEOUT=35
# Performance only: unchanged scientific depth, bounded I/O and short-lived caches.
ENNOSCHOLAR_V2_FULLTEXT_BATCH_TIMEOUT=60
ENNOSCHOLAR_V2_FULLTEXT_ATTEMPT_TIMEOUT=12
ENNOSCHOLAR_V2_FULLTEXT_CONNECT_TIMEOUT=5
ENNOSCHOLAR_V2_FULLTEXT_HEADERS_TIMEOUT=10
ENNOSCHOLAR_V2_FULLTEXT_READ_TIMEOUT=10
ENNOSCHOLAR_V2_FULLTEXT_CONCURRENCY=3
ENNOSCHOLAR_V2_ANALYSIS_CONCURRENCY=3
ENNOSCHOLAR_V2_SEMANTIC_CONCURRENCY=2
ENNOSCHOLAR_V2_OPENALEX_CONCURRENCY=3
# Minimum spacing: Semantic Scholar 1s, OpenAlex 0.1s; arXiv stays serial + 3s.
ENNOSCHOLAR_V2_SEMANTIC_REQUEST_INTERVAL=1
ENNOSCHOLAR_V2_OPENALEX_REQUEST_INTERVAL=0.1
ENNOSCHOLAR_V2_SEARCH_TIMEOUT=120
ENNOSCHOLAR_V2_SEARCH_CANDIDATES=50
ENNOSCHOLAR_V2_MAX_ARTICLES=10000
ENNOSCHOLAR_V2_SOFT_TOOL_BUDGET=16
ENNOSCHOLAR_V2_HARD_TOOL_BUDGET=32
ENNOSCHOLAR_V2_MAX_ROUNDS=10
ENNOSCHOLAR_V2_MAX_INPUT_TOKENS=48000
# Extreme serialized-payload safety only; not a token budget.
ENNOSCHOLAR_V2_MAX_CONTEXT_BYTES=4000000
ENNOSCHOLAR_V2_COMPACT_THRESHOLD=12000
# Optional API credentials / contact
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
ENNOSCHOLAR_V2_CONTACT_EMAIL=
