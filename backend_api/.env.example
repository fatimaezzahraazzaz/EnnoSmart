# EnnoSmart Backend API

APP_NAME=EnnoSmart Backend API
ENV=dev

# Change this in real use.
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:3000

# Envoi des liens de récupération (facultatif en développement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ennoma.app
SMTP_USE_TLS=true

# Option 1: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ennosmart

# Option 2: Local quick test without PostgreSQL
DATABASE_URL=sqlite:///./ennosmart_dev.db

# Capacité recommandée pour 20+ utilisateurs (PostgreSQL en production).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
WEB_THREAD_LIMIT=80

# Une seule mutation longue à la fois par conversation ; les conversations
# différentes restent parallèles. Redis étend le verrou à plusieurs processus.
SESSION_LOCK_DISTRIBUTED=true
SESSION_LOCK_REDIS_URL=redis://127.0.0.1:6379/0
SESSION_LOCK_TTL_SECONDS=3900

# File de capacité commune FastAPI/Celery pour protéger le quota fournisseur.
ENNOSMART_LLM_MAX_CONCURRENCY=8
ENNOSMART_LLM_QUEUE_TIMEOUT_SECONDS=900
ENNOSMART_LLM_SLOT_LEASE_SECONDS=900
ENNOSMART_LLM_DISTRIBUTED_LIMITER=true
ENNOSMART_LLM_REDIS_URL=redis://127.0.0.1:6379/0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ENNOSMART_ROOT=/opt/ennosmart
ENNOSMART_BASE_DIR=/opt/ennosmart
ENNOSMART_DATA_ROOT=/var/lib/ennosmart
ENNOSMART_STORAGE_ROOT=/var/lib/ennosmart/storage
UPLOAD_ROOT=/var/lib/ennosmart/storage/uploads
AI_OUTPUT_ROOT=/var/lib/ennosmart/outputs/safe_rag_upload
ENNOSMART_HOST_DATA_DIR=/mnt/ennosmart-data
ENNOSMART_POSTGRES_DATA_DIR=/mnt/ennosmart-data/postgres
ENNOSMART_REDIS_DATA_DIR=/mnt/ennosmart-data/redis

MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.pptx,.ppt,.xlsx,.xls,.txt,.png,.jpg,.jpeg,.msg

# Optional hooks to launch your existing AI scripts later.
# ENNODIAGNOSTIC_SCRIPT=/opt/ennosmart/app_enno_restart_upload_diag_scholar.py
# ENNOSCHOLAR_SCRIPT=/opt/ennosmart/app_enno_restart_upload_diag_scholar.py
AI_RUN_TIMEOUT_SECONDS=3600

# Collecte CIR : EnnoSmart lit seulement le dossier professionnel synchronisé.
# Renseigner le chemin local de la machine ; aucune écriture sur SharePoint.
POWER_AUTOMATE_IMPORT_ROOT=
POWER_AUTOMATE_FAKE_ROOT=/var/lib/ennosmart/power_automate_fake_inbox
# Journaux, copies de travail et Memory V2 restent hors du dépôt applicatif.
POWER_AUTOMATE_AUDIT_ROOT=/var/lib/ennosmart/storage/power_automate_import
ENNOSMART_EXPERIENCE_MEMORY_V2_DIR=/var/lib/ennosmart/storage/experience_memory_v2
ENNOSMART_MEMORY_V2_ROOT=/var/lib/ennosmart/storage/organismes
ENNOSMART_LOG_ROOT=/var/lib/ennosmart/logs
ENNOSMART_CACHE_ROOT=/var/lib/ennosmart/cache
# Extraction EnnoDiagnostic : paramètres génériques, sans règle client/projet.
ENNOSMART_DIAGNOSTIC_VISION_MODE=text_only
ENNOSMART_DIAGNOSTIC_FORMULA_MODE=fast
ENNOSMART_NLP_MIN_CANDIDATES=700
ENNOSMART_NLP_CANDIDATES_PER_DOCUMENT=120
ENNOSMART_NLP_MAX_CANDIDATES_CAP=2500
POWER_AUTOMATE_MAX_FILE_MB=100
# Optionnel, uniquement pour les anciens Word .doc (conversion de la copie locale).
LIBREOFFICE_BIN=/usr/bin/libreoffice
