# EnnoSmart Backend API

APP_NAME=EnnoSmart Backend API
ENV=dev

# Change this in real use.
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:3000

# Envoi des liens de récupération (facultatif en développement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ennoma.app
SMTP_USE_TLS=true

# Option 1: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ennosmart

# Option 2: Local quick test without PostgreSQL
DATABASE_URL=sqlite:///./ennosmart_dev.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UPLOAD_ROOT=C:/EnnoSmart/storage/uploads
AI_OUTPUT_ROOT=C:/EnnoSmart/outputs/safe_rag_upload

MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.pptx,.ppt,.xlsx,.xls,.txt,.png,.jpg,.jpeg,.msg

# Optional hooks to launch your existing AI scripts later.
# ENNODIAGNOSTIC_SCRIPT=C:/EnnoSmart/app_enno_restart_upload_diag_scholar.py
# ENNOSCHOLAR_SCRIPT=C:/EnnoSmart/app_enno_restart_upload_diag_scholar.py
AI_RUN_TIMEOUT_SECONDS=3600

# Collecte CIR : Power Automate dépose des copies dans un OneDrive professionnel.
# EnnoSmart lit seulement le dossier synchronisé ; aucune écriture sur SharePoint.
POWER_AUTOMATE_IMPORT_ROOT=C:/Users/dell/OneDrive - Ennodev/ENNODEV - Clients
POWER_AUTOMATE_FAKE_ROOT=C:/EnnoSmart/tests/fixtures/fake_power_automate_inbox
POWER_AUTOMATE_AUDIT_ROOT=C:/EnnoSmart/storage/power_automate_import
POWER_AUTOMATE_MAX_FILE_MB=100
