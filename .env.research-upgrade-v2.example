ENNOSCHOLAR_PREFLIGHT_ENABLED=1
ENNOSCHOLAR_PREFLIGHT_MODE=all

ENNOSCHOLAR_TARGET_FULLTEXT=10
ENNOSCHOLAR_PREFLIGHT_INITIAL_BATCH=10
ENNOSCHOLAR_PREFLIGHT_BATCH_SIZE=5
ENNOSCHOLAR_PREFLIGHT_MAX_SCAN=25
ENNOSCHOLAR_PREFLIGHT_WORKERS=4
ENNOSCHOLAR_PREFLIGHT_LEGAL_WORKERS=2
ENNOSCHOLAR_MIN_FULLTEXT_PER_VERROU=2

ENNOSCHOLAR_DEEP_DISCOVERY_ENABLED=1
ENNOSCHOLAR_DISCOVERY_SEEDS=3
ENNOSCHOLAR_DISCOVERY_REFS_PER_SEED=4
ENNOSCHOLAR_DISCOVERY_CITES_PER_SEED=4
ENNOSCHOLAR_DISCOVERY_MAX_NEW=18
ENNOSCHOLAR_DISCOVERY_WORKERS=6
OPENCITATIONS_TIMEOUT=6
OPENCITATIONS_MAX_RETRIES=1
OPENCITATIONS_REDIS_CACHE_TTL_SECONDS=604800

ENNOSCHOLAR_REDIS_ENABLED=1
ENNOSCHOLAR_PREFLIGHT_ASYNC=1
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

ENNOSCHOLAR_GROBID_ENABLED=1
GROBID_URL=http://127.0.0.1:8070
GROBID_TIMEOUT=45

# Keep 0 until run_legal_fulltext_mcp.ps1 is running.
ENNOSCHOLAR_PREFLIGHT_USE_LEGAL_MCP=0
ENNOSCHOLAR_LEGAL_MCP_ENABLED=1
ENNOSCHOLAR_LEGAL_MCP_REST_URL=http://127.0.0.1:8010/api/resolve
