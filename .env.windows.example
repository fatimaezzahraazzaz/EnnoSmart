# EnnoSmart - Docker Desktop sous Windows
# Copier ce fichier vers .env et remplacer tous les CHANGE_ME.

ENV=development
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

POSTGRES_DB=ennosmart
POSTGRES_USER=ennosmart
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Le code reste dans Git. Les documents, Chroma, JSON NLP, sorties et caches
# vivent dans ce dossier Windows, monté dans les conteneurs.
ENNOSMART_HOST_DATA_DIR=C:/EnnoSmartData
ENNOSMART_DATA_ROOT=/var/lib/ennosmart
ENNOSMART_STORAGE_ROOT=/var/lib/ennosmart/storage
UPLOAD_ROOT=/var/lib/ennosmart/storage/uploads
AI_OUTPUT_ROOT=/var/lib/ennosmart/outputs/safe_rag_upload
ENNOSMART_EXPERIENCE_MEMORY_V2_DIR=/var/lib/ennosmart/storage/experience_memory_v2
ENNOSMART_MEMORY_V2_ROOT=/var/lib/ennosmart/storage/organismes
ENNOSMART_LOG_ROOT=/var/lib/ennosmart/logs
ENNOSMART_CACHE_ROOT=/var/lib/ennosmart/cache
POWER_AUTOMATE_IMPORT_ROOT=/var/lib/ennosmart/storage/power_automate_import
POWER_AUTOMATE_AUDIT_ROOT=/var/lib/ennosmart/storage/power_automate_import

ENNOSMART_LLM_PROVIDER=openai
ENNOSMART_OPENAI_MODEL=gpt-4.1-mini
ENNOSMART_LLM_WRITER_MODEL=gpt-4.1
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
IEEE_XPLORE_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=

MAX_UPLOAD_SIZE_MB=100
ENNOSMART_DIAGNOSTIC_VISION_MODE=text_only
ENNOSMART_DIAGNOSTIC_FORMULA_MODE=fast
ENNOSMART_EXTRACTION_FORMULA_MODE=off
ENNOSMART_ENABLE_TRANSCRIPTION=1
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DIARIZATION=false
