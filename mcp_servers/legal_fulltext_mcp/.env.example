# ============================================================
# EnnoScholar Legal Fulltext MCP — fournisseurs gratuits/légaux
# ============================================================
ENNOSCHOLAR_LEGAL_MCP_ENABLED=1
ENNOSCHOLAR_LEGAL_MCP_HOST=127.0.0.1
ENNOSCHOLAR_LEGAL_MCP_PORT=8010
ENNOSCHOLAR_LEGAL_MCP_URL=http://127.0.0.1:8010/mcp
ENNOSCHOLAR_LEGAL_MCP_REST_URL=http://127.0.0.1:8010/api/resolve

# Le backend attend le résultat de plusieurs fournisseurs.
ENNOSCHOLAR_LEGAL_MCP_CLIENT_TIMEOUT_SECONDS=300
ENNOSCHOLAR_LEGAL_MCP_CLIENT_MAX_RETRIES=2
ENNOSCHOLAR_LEGAL_MCP_TIMEOUT_SECONDS=30
ENNOSCHOLAR_LEGAL_MCP_MAX_RETRIES=3
ENNOSCHOLAR_LEGAL_MCP_VERIFY_PDF=1
ENNOSCHOLAR_LEGAL_MCP_STOP_ON_FIRST_VERIFIED=1
ENNOSCHOLAR_LEGAL_MCP_MAX_CANDIDATES_PER_PROVIDER=12
ENNOSCHOLAR_LEGAL_MCP_MAX_LANDING_PDF_LINKS=8
ENNOSCHOLAR_LEGAL_MCP_VALIDATE_PUBLIC_NETWORK_URLS=1
ENNOSCHOLAR_LEGAL_MCP_PROVIDER_MIN_INTERVAL_SECONDS=0.20
ENNOSCHOLAR_SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.10
ENNOSCHOLAR_LEGAL_MCP_PROVIDER_COOLDOWN_SECONDS=60
ENNOSCHOLAR_FULLTEXT_USER_AGENT=EnnoSmart-EnnoScholar-LegalFulltext/1.6

# Recherche exhaustive pour les seuls articles en échec direct.
ENNOSCHOLAR_LEGAL_MCP_SEARCH_ALL=1

# Validation bibliographique MCP + validation du contenu dans le backend.
ENNOSCHOLAR_FULLTEXT_MIN_IDENTITY_SCORE=0.90
ENNOSCHOLAR_FULLTEXT_MIN_TITLE_SCORE=0.82
ENNOSCHOLAR_FULLTEXT_ALLOW_TITLE_MATCH=1
ENNOSCHOLAR_FULLTEXT_DOI_TITLE_CONFLICT_SCORE=0.55
ENNOSCHOLAR_FULLTEXT_EXACT_TITLE_REPOSITORY_SCORE=0.985
ENNOSCHOLAR_FULLTEXT_ALLOW_EXACT_TITLE_REPOSITORY_MATCH=1

# Cache : ne pas figer les échecs temporaires ou négatifs.
ENNOSCHOLAR_LEGAL_MCP_CACHE_ENABLED=1
ENNOSCHOLAR_LEGAL_MCP_CACHE_TTL_SECONDS=86400
ENNOSCHOLAR_LEGAL_MCP_CACHE_NEGATIVE_RESULTS=0
ENNOSCHOLAR_LEGAL_MCP_CACHE_DB=/opt/ennosmart/storage/mcp/legal_fulltext_cache.sqlite3
ENNOSCHOLAR_LEGAL_MCP_AUDIT_LOG=/opt/ennosmart/logs/legal_fulltext_mcp_audit.jsonl

# Fournisseurs gratuits ou sans moteur de recherche payant.
# UNPAYWALL_EMAIL et CROSSREF_MAILTO peuvent utiliser la même adresse technique.
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# CORE reste facultatif. Laisser vide pour le désactiver.
CORE_API_KEY=
ENNOSCHOLAR_CORE_DETAIL_LIMIT=3

# Pas de Brave, pas de PublicWeb et pas de reprise aveugle des URLs directes.
ENNOSCHOLAR_LEGAL_MCP_PROVIDER_ORDER=unpaywall,openalex,crossref,core,hal,arxiv,europe_pmc,zenodo

# Enrichissement bibliographique.
ENNOSCHOLAR_METADATA_ENRICHMENT_ENABLED=1
ENNOSCHOLAR_METADATA_TITLE_ACCEPT_SCORE=0.72
ENNOSCHOLAR_METADATA_TITLE_CONFLICT_SCORE=0.55
ENNOSCHOLAR_METADATA_TITLE_RECONCILE_SCORE=0.94
ENNOSCHOLAR_METADATA_EXACT_TITLE_RECONCILE_SCORE=0.985

# Semantic Scholar désactivé (429 fréquents)
ENNOSCHOLAR_SEMANTIC_SCHOLAR_ENABLED=0
